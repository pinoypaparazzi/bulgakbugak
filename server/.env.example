# =========================================================
# AT YOUR SERVICE API — environment variables
# Copy this file to server/.env and fill in your values.
# server/.env is git-ignored. Never commit real passwords.
# =========================================================

# Port the API listens on (the Vite dev server proxies /api to it)
PORT=4000

# --- MongoDB connection string (pick ONE) ---------------------
# Local MongoDB server:
MONGODB_URI=mongodb://127.0.0.1:27017/at-your-service

# MongoDB Atlas (cloud). Get it from Atlas > Database > Connect > Drivers.
# If your password has special characters (@ : / ? # %), URL-encode them.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=at-your-service

# Optional: database name. Overrides the one in MONGODB_URI (useful for Atlas URIs that don't include one).
MONGODB_DB_NAME=at-your-service

# Staff sign-in needs transactions (one-time Super Duper Admin setup), which
# MongoDB Atlas supports. A plain single local mongod does not; run it as a
# replica set if you use a local server.

# --- CORS ---------------------------------------------------
# Comma-separated list of website origins allowed to call the public API
# (/api/health, /api/inquiries). No cookies or credentials are allowed.
CORS_ORIGIN=http://localhost:5173

# --- Staff portal (sign-in and sessions) ---------------------
# REQUIRED. Signs the staff session cookie. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep it secret and different in each environment. Changing it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-value-of-at-least-32-characters

# "production" on the live server: session cookies become HTTPS-only.
NODE_ENV=development

# Express "trust proxy" setting, needed behind a hosting proxy/load balancer so
# HTTPS and client IPs (used for sign-in rate limits) are detected correctly.
# Leave empty locally. In production it defaults to 1 (one proxy hop).
TRUST_PROXY=

# Leave empty when the staff app reaches this API through its own /api path
# (the Vite dev proxy locally; a host proxy in production). Only set this if
# the staff app is served from a different origin and calls the API directly,
# e.g. https://pogiako.example.com (credentialed CORS is allowed ONLY for these).
STAFF_APP_ORIGINS=
