# =========================================================
# AT YOUR SERVICE API — environment variables
# Copy this file to server/.env and fill in your values.
# server/.env is git-ignored. Never commit real passwords.
# =========================================================

# Port the API listens on (the Vite dev server proxies /api to it)
PORT=4000

# --- MongoDB connection string (pick ONE) ---------------------
# Local MongoDB server:
MONGODB_URI=mongodb://127.0.0.1:27017/at-your-service

# MongoDB Atlas (cloud). Get it from Atlas > Database > Connect > Drivers.
# If your password has special characters (@ : / ? # %), URL-encode them.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=at-your-service

# Optional: database name. Overrides the one in MONGODB_URI (useful for Atlas URIs that don't include one).
MONGODB_DB_NAME=at-your-service

# --- CORS ---------------------------------------------------
# Comma-separated list of website origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
